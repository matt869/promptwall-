# ---------------------------------------------------------------------------
# PromptWall configuration. Copy to .env and edit. All vars are PW_ prefixed.
# ---------------------------------------------------------------------------

# --- Server ---
PW_HOST=0.0.0.0
PW_PORT=8080
PW_LOG_LEVEL=INFO
PW_LOG_FORMAT=json           # json | console

# --- Gateway auth: clients must send `Authorization: Bearer <key>` ---
# Comma-separated. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
PW_API_KEYS=pw_dev_localkey
PW_ADMIN_API_KEYS=pw_admin_localkey
PW_AUTH_REQUIRED=true

# --- Upstream model provider ---
PW_UPSTREAM_PROVIDER=openai_compat   # openai_compat | anthropic
PW_UPSTREAM_BASE_URL=https://api.openai.com/v1
PW_UPSTREAM_API_KEY=sk-replace-me
PW_UPSTREAM_TIMEOUT_S=60

# --- Enforcement ---
# monitor  : evaluate + log, never modify traffic (use this first, always)
# enforce  : block/redact per policy
PW_MODE=monitor
# What to do when a layer errors or times out. See docs/adr/003.
PW_FAIL_MODE=open            # open | closed

# --- Layer toggles ---
PW_L2_ENABLED=true
PW_L2_MODEL_PATH=models/artifacts/classifier.onnx
PW_L3_ENABLED=false          # LLM judge: costs money + latency
PW_L3_MODEL=gpt-4o-mini
PW_L3_BASE_URL=
PW_L3_API_KEY=

# --- Decision thresholds (calibrated probabilities, 0..1) ---
PW_THRESHOLD_BLOCK=0.90
PW_THRESHOLD_REVIEW=0.55     # band between review..block escalates to L3 judge

# --- Budgets: the pipeline degrades gracefully rather than blowing latency ---
PW_BUDGET_INPUT_MS=120
PW_BUDGET_OUTPUT_MS=80
PW_BUDGET_JUDGE_MS=2500

# --- Session / conversation risk ---
PW_SESSION_BACKEND=memory    # memory | redis
PW_REDIS_URL=redis://localhost:6379/0
PW_SESSION_TTL_S=3600

# --- Rate limiting (token bucket, per API key) ---
PW_RATE_LIMIT_RPS=20
PW_RATE_LIMIT_BURST=40

# --- Telemetry ---
PW_METRICS_ENABLED=true
PW_AUDIT_ENABLED=true
PW_AUDIT_PATH=./audit.log
# Store full prompt text in the audit log. Off by default: audit logs of an
# LLM gateway are a high-value target and contain user data by definition.
PW_AUDIT_STORE_CONTENT=false
PW_AUDIT_HMAC_KEY=
PW_TRACING_ENABLED=false
PW_OTLP_ENDPOINT=http://localhost:4318

# --- Operator console (/dashboard, /playground) ---
# Static HTML only. The pages carry no data -- every number on them is fetched
# from /admin at runtime and still requires an admin key -- so serving them
# discloses nothing that / does not already. Set false to remove the routes.
PW_UI_ENABLED=true

# --- Spotlighting: how untrusted content is fenced before the model sees it ---
# none | delimit | datamark | encode
PW_SPOTLIGHT_MODE=datamark
# Spans at or below this trust level get fenced.
# untrusted | third_party | user | developer | system
PW_SPOTLIGHT_FLOOR=third_party
